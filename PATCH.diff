+def stock_text(text,user,store):
+    if user["id"]!=ADMIN_ID:
+        return None
+    value=draft(store)
+    if value.get("step") not in ("stock_quantity","stock_confirm"):
+        return None
+    if text.startswith("/"):
+        draft(store,{})
+        return None
